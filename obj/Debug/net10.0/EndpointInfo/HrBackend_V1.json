          },
          "nationalId": {
            "type": "string",
            "nullable": true
          },
          "hireDate": {
            "type": "string",
            "format": "date"
          },
          "salary": {
            "type": "number",
            "format": "double"
          },
          "attendDate": {
            "type": "string",
            "format": "time"
          },
          "leaveDate": {
            "type": "string",
            "format": "time"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
