  "components": {
    "schemas": {
      "AddEmpDTO": {
        "required": [
          "attendDate",
          "birthDate",
          "gender",
          "hireDate",
          "leaveDate",
          "nationalId",
          "nationality",
          "phoneNumber",
          "salary"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "phoneNumber": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "format": "tel"
          },
          "gender": {
            "minLength": 1,
            "pattern": "^(Male|Female)$",
            "type": "string"
          },
          "nationality": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "nationalId": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "hireDate": {
            "type": "string",
            "format": "date"
          },
          "salary": {
            "maximum": 1000000,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "attendDate": {
            "type": "string",
            "format": "time"
          },
          "leaveDate": {
            "type": "string",
            "format": "time"
          }
        },
        "additionalProperties": false
      },
      "CheckBoxDTO": {
        "type": "object",
        "properties": {
          "displayValue": {
            "type": "string",
            "nullable": true
          },
          "isSelected": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CreatePermissionGroupDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "permissionKeys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateRoleDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 256,
            "minLength": 2,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "permissionGroupIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Employee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
